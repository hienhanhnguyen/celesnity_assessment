# Environment template. Copy to `.env` and fill in real values.
# -----------------------------------------------------------

# Internal Application Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=celesnity
POSTGRES_PASSWORD=celesnity_app_pw_change_me
POSTGRES_DB=celesnity
# Full URL used by the backend 
DATABASE_URL=postgres://celesnity:celesnity_app_pw_change_me@postgres:5432/celesnity

# Factory production database (collectable source, seeded in Docker) 
FACTORY_DB_HOST=postgres
FACTORY_DB_PORT=5432
FACTORY_DB_NAME=factory
FACTORY_DB_READONLY_USER=factory_readonly
FACTORY_DB_READONLY_PASSWORD=factory_readonly_pw_change_me

# Secret encryption (AES-256-GCM) 
# 32-byte key, base64 or hex. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Domain config
STALE_THRESHOLD_MINUTES=15
SEED_ORG_ID=org-celesnity-001
SEED_ACTOR=manager@celesnity.local

# Local source endpoints (fixtures service)
APP_API_BASE_URL=http://fixtures:4000
SUPPLIER_CRAWLER_BASE_URL=http://fixtures:4000

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000
FIXTURES_PORT=4000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGIN=*
